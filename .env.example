# Local LLM AI Agent — environment spec (copy to .env and adjust).
# .env is gitignored; this .env.example is the tracked specification.
# Copy to .env and adjust paths to your environment.

# --- Model locations (REQUIRED — set to your actual model directories) ---
MODEL_SAFETENSORS_DIR=/path/to/your/gemma-4-safetensors
MODEL_GGUF_DIR=/path/to/your/gemma-4-gguf
# GGUF file to serve with llama.cpp (a file inside MODEL_GGUF_DIR).
# Default Q6_K_XL (balance). Q4_K_XL = faster/long-ctx, Q8_K_XL = max fidelity.
GGUF_FILE=gemma-4-31B-it-UD-Q6_K_XL.gguf

# --- Serving (primary engine: llama.cpp / llama-server) ---
SERVE_ENGINE=llamacpp          # llamacpp (primary) | vllm (validation only)
SERVE_HOST=127.0.0.1
SERVE_PORT=8000                 # the MODEL server (llama-server / openai_base_url)
API_PORT=8080                  # the core API GATEWAY (uvicorn) — MUST differ from SERVE_PORT
SERVED_MODEL_NAME=gemma-4-31b-it
CUDA_VISIBLE_DEVICES=0,1       # comma-separated GPU indices to use

# llama.cpp serve params:
N_GPU_LAYERS=999               # -ngl : offload all layers to GPU
SPLIT_MODE=layer               # --split-mode : layer (throughput) | row
TENSOR_SPLIT=1,1               # --tensor-split : even across the two cards
CTX_SIZE=16384                 # -c : context (model trained for 262144; raise as KV-VRAM allows)
USE_JINJA=true                 # --jinja : use the GGUF-embedded gemma4 chat template (REQUIRED for correct chat)

# --- vLLM-only (validation engine; ignored when SERVE_ENGINE=llamacpp) ---
TENSOR_PARALLEL_SIZE=2         # vLLM --tensor-parallel-size
DTYPE=bfloat16                 # vLLM safetensors dtype
# MAX_MODEL_LEN=16384          # vLLM --max-model-len (optional)

# --- API auth ---
AUTH_ENABLED=true              # protected routes require a credential (only /health is public)
# Static API key (full access; for trusted machine clients). Generate a strong value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=                       # REQUIRED if AUTH_ENABLED=true and you want API-key access
# JWT signing secret (HS256). Use >= 32 random bytes:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=                    # REQUIRED to issue/verify JWTs
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
# NOTE: API_KEY and JWT_SECRET are secrets — keep them only in .env (gitignored), never commit.

# --- API gateway security (CORS / hosts / health detail) ---
# CORS_ALLOW_ORIGINS / TRUSTED_HOSTS are JSON lists when set via env, e.g.:
#   CORS_ALLOW_ORIGINS=["https://app.example.com"]
#   TRUSTED_HOSTS=["127.0.0.1","localhost"]
# EXPOSE_HEALTH_DETAIL=false   # keep false in production (redacts internal error detail)
